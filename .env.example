# ------------------------------------------------------------------------------
# Lsky Pro 环境变量示例
# ------------------------------------------------------------------------------
# 使用方式：
# 1. 复制当前文件为 .env
# 2. 按你的部署环境修改下面的配置
# 3. 首次启动后若 APP_KEY 为空，程序会自动生成；也可以手动执行 php artisan key:generate
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------------------------
# 站点名称，会显示在页面标题、邮件模板等位置
APP_NAME="Lsky Pro"

# 运行环境：
# local   开发环境
# test    测试环境
# prod    生产环境
APP_ENV=prod

# Laravel 应用密钥，用于加密 Cookie / Session 等敏感数据
# 留空时，程序首次启动会自动生成
APP_KEY=

# 是否开启调试模式：
# true  会显示详细报错，适合开发调试
# false 生产环境推荐关闭，避免泄露敏感信息
APP_DEBUG=false

# 应用访问地址，务必改成你的实际域名或访问入口
# 例如：
# http://localhost
# https://img.example.com
APP_URL=https://localhost

# ------------------------------------------------------------------------------
# Docker Compose 一键启动专用变量
# ------------------------------------------------------------------------------
# 以下变量仅在使用 docker compose 启动时生效。
# 如果你直接用 PHP / Nginx / Apache 部署，可以忽略这一组。

# 映射到宿主机的访问端口。
# 例如：
# 8080  -> 访问 http://127.0.0.1:8080
# 12312 -> 访问 http://127.0.0.1:12312
LSKY_HTTP_PORT=8080

# Docker Compose 注入到容器内的外部访问地址。
# 它会覆盖容器里的 APP_URL，用于生成上传链接、页面资源地址等。
# 如果你改了上面的 LSKY_HTTP_PORT，这里也应同步修改。
# 例如：
# http://localhost:8080
# https://img.rydct.com:12312
LSKY_APP_URL=http://localhost:8080

# Docker Compose 模式下使用的应用密钥。
# 留空时会回退到 compose 文件中的默认值；生产环境强烈建议改成你自己的安全值。
# 可通过以下命令生成：
# php artisan key:generate --show
LSKY_APP_KEY=

# 首次启动时自动创建的管理员名称
LSKY_ADMIN_NAME=admin

# 首次启动时自动创建的管理员邮箱
LSKY_ADMIN_EMAIL=admin@local.test

# 首次启动时自动创建的管理员密码
# 仅适合本地演示，正式环境请务必修改
LSKY_ADMIN_PASSWORD=admin123456

# ------------------------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------------------------
# 日志通道：
# single  单文件日志
# daily   按天切分日志
# stack   组合通道
LOG_CHANNEL=daily

# PHP 废弃警告日志通道，通常保持 null 即可
LOG_DEPRECATIONS_CHANNEL=null

# 日志级别，常见值：
# debug / info / notice / warning / error / critical
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------------------------
# 数据库驱动：
# mysql / pgsql / sqlite / sqlsrv
# 如果你准备通过 Web 安装页初始化，也可以先留空
DB_CONNECTION=

# 数据库主机地址
# SQLite 可留空
DB_HOST=

# 数据库端口
# MySQL 常见为 3306，PostgreSQL 常见为 5432
DB_PORT=

# 数据库名称
# SQLite 可填写数据库文件绝对路径
DB_DATABASE=

# 数据库用户名
DB_USERNAME=

# 数据库密码
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 广播、缓存、文件系统、队列、会话
# ------------------------------------------------------------------------------
# 广播驱动：
# log / null / pusher / redis
BROADCAST_DRIVER=log

# 缓存驱动：
# file / redis / memcached / database / array
CACHE_DRIVER=file

# 默认文件存储磁盘
# 当前项目内置本地上传磁盘为 uploads，通常不要改成不存在的值
FILESYSTEM_DISK=uploads

# 队列驱动：
# sync    同步执行，最省心
# database / redis 适合需要异步任务时使用
QUEUE_CONNECTION=sync

# Session 驱动：
# file / cookie / database / redis / array
SESSION_DRIVER=file

# Session 生命周期，单位为分钟
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# Memcached 配置
# ------------------------------------------------------------------------------
# 仅当 CACHE_DRIVER=memcached 时生效
MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------------------------
# 仅当缓存、队列、会话等使用 Redis 时需要配置
REDIS_HOST=127.0.0.1

# Redis 密码，无密码时保持 null
REDIS_PASSWORD=null

# Redis 端口，默认 6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Pusher / WebSocket 配置
# ------------------------------------------------------------------------------
# 仅当 BROADCAST_DRIVER=pusher 时需要填写
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# 前端构建时使用的 Pusher 变量，通常保持和上方一致
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------------------
# Ignition 配置
# ------------------------------------------------------------------------------
# 是否允许把异常信息分享到 Ignition 平台
# 生产环境建议保持 false
IGNITION_SHARING_ENABLED=false
