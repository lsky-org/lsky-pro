APP_NAME="Lsky Pro"
APP_ENV=prod
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=
# Example for local dev:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
INIT_AUTO_BOOTSTRAP=false
INIT_ADMIN_NAME=Administrator
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=ChangeMe_123456
ALLOW_DESTRUCTIVE=0

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
IMAGE_DELETE_ASYNC=false
IMAGE_DELETE_QUEUE_CONNECTION=sync
IMAGE_DELETE_QUEUE=image-delete
IMAGE_DELETE_QUEUE_TRIES=3
IMAGE_DELETE_QUEUE_TIMEOUT=120
IMAGE_DELETE_QUEUE_BACKOFF=10,30,60
UPLOAD_PIPELINE_QUEUE_CONNECTION=sync
UPLOAD_PIPELINE_QUEUE=upload-critical
UPLOAD_PIPELINE_QUEUE_TRIES=3
UPLOAD_PIPELINE_QUEUE_TIMEOUT=180
UPLOAD_PIPELINE_QUEUE_BACKOFF=5,15,30
WEBHOOK_QUEUE_CONNECTION=sync
AI_PROMPT_QUEUE_CONNECTION=sync
AI_PROMPT_QUEUE=ai-prompt
AI_PROMPT_QUEUE_TRIES=2
AI_PROMPT_QUEUE_TIMEOUT=60
IMAGE_TTL_ENABLED=false
IMAGE_TTL_DEFAULT_SECONDS=0
IMAGE_RECYCLE_BIN_ENABLED=false
IMAGE_PROCESS_DRIVER=imagick
SESSION_DRIVER=file
SESSION_LIFETIME=120
SIGNED_URL_ENABLED=false
SIGNED_URL_PRIVATE_ONLY=false
SIGNED_URL_TTL=300
# Optional: set a dedicated HMAC key, defaults to APP_KEY when empty
SIGNED_URL_KEY=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

IGNITION_SHARING_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"
